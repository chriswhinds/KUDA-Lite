# /etc/kudalite/dashboard.env — environment for the dashboard services (systemd EnvironmentFile).
# Full list of variables: dashboard/README.md#configuration

# --- FastAPI backend (kudalite-dashboard-api) ---
# Controller host API. The dashboard normally runs on the controller Pi itself.
KUDALITE_CONTROLLER=@CONTROLLER@:7070
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_POLL_SECONDS=1.0
DASHBOARD_HISTORY_SECONDS=900
DASHBOARD_TEMP_WARNING_C=70
DASHBOARD_TEMP_CRITICAL_C=80
DASHBOARD_MEM_WARNING_PCT=80
DASHBOARD_MEM_CRITICAL_PCT=90

# --- Next.js front end (kudalite-dashboard-web) ---
# Where the web server proxies /api/*. Keep the backend on 127.0.0.1; only the web port is exposed.
DASHBOARD_API_URL=http://127.0.0.1:8000
# Address and port browsers connect to.
HOSTNAME=0.0.0.0
PORT=3000
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=production
