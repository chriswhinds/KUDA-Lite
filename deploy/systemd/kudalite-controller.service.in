[Unit]
Description=KUDA-Lite cluster controller
Documentation=file://@KUDALITE_DOCDIR@/DEPLOYMENT.md
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=kudalite
Group=kudalite
ExecStart=@KUDALITE_BINDIR@/cl-controller --config /etc/kudalite/controller.conf
Restart=always
RestartSec=2
LimitNOFILE=65536

# Hardening: the controller only needs the network.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
